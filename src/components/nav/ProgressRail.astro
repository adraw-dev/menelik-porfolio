---
import { getLang, t } from '../../i18n';
const ui = t(getLang(Astro.currentLocale));
// Riel lateral de capítulos (escritorio). Los capítulos se leen de [data-chapter] en tiempo de ejecución
// para no duplicar la lista; aquí solo se define el contenedor.
---

<nav class="rail" aria-label={ui.nav.rail} data-rail>
  <ol role="list" class="rail__list" data-rail-list></ol>
  <p class="rail__count meta" aria-hidden="true"><span data-rail-current>01</span> / <span data-rail-total>01</span></p>
</nav>

<style>
  .rail {
    position: fixed;
    right: clamp(0.8rem, 1.4vw, 1.6rem);
    top: 50%;
    z-index: 50;
    display: none;
    translate: 0 -50%;
    color: var(--tinta);
    transition: color var(--dur-slow) var(--ease-out), opacity var(--dur-slow) var(--ease-out);
  }

  .rail[data-zone='dark'] {
    color: var(--crema);
  }

  @media (min-width: 1024px) and (pointer: fine) {
    :global(html.js:not(.is-loading)) .rail {
      display: grid;
      justify-items: end;
      gap: 1rem;
    }
  }

  .rail__list {
    display: grid;
    gap: 0.35rem;
    justify-items: end;
  }

  .rail :global(a) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 22px;
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .rail :global(.rail__label) {
    opacity: 0;
    translate: 6px 0;
    transition: opacity var(--dur-base) var(--ease-out), translate var(--dur-base) var(--ease-out);
    white-space: nowrap;
  }

  .rail :global(.rail__dot) {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: currentColor;
    opacity: 0.35;
    transition: height var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out), background-color var(--dur-base);
  }

  .rail :global(a[aria-current='true'] .rail__dot) {
    height: 22px;
    opacity: 1;
    background: var(--celeste-500);
  }

  .rail :global(a:hover .rail__label),
  .rail :global(a:focus-visible .rail__label),
  .rail :global(a[aria-current='true'] .rail__label) {
    opacity: 1;
    translate: 0 0;
  }

  .rail :global(a[aria-current='true'] .rail__label) {
    opacity: 0.75;
  }

  .rail__count {
    color: inherit;
    opacity: 0.7;
  }
</style>
