---
import Wordmark from '../ui/Wordmark.astro';
import { getLang, t, otherLang, homePath } from '../../i18n';

const lang = getLang(Astro.currentLocale);
const ui = t(lang);
const other = otherLang(lang);
const ids = ['sobre', 'trabajo', 'video', 'servicios', 'contacto'] as const;
const links = ids.map((id) => ({ href: `#${id}`, label: ui.nav.links[id] }));
---

<header class="nav" data-nav>
  <a class="nav__brand" href="#inicio" aria-label={ui.nav.home}>
    <Wordmark class="nav__logo" />
  </a>

  <nav class="nav__pill glass" aria-label={ui.nav.main}>
    <ul role="list">
      {links.map((l) => <li><a href={l.href} data-nav-link>{l.label}</a></li>)}
    </ul>
  </nav>

  <div class="nav__end">
    <a
      class="nav__lang glass"
      href={homePath(other)}
      hreflang={other}
      lang={other}
      aria-label={ui.nav.switchLabel}
      data-lang-switch={homePath(other)}
    >{ui.nav.switchShort}</a>
    <a class="btn btn--solid nav__cta" href="#contacto">{ui.nav.cta}</a>
    <button
      class="nav__toggle glass"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      data-menu-toggle
      data-label-open={ui.nav.menu}
      data-label-close={ui.nav.close}
    >
      <span class="nav__toggle-label">{ui.nav.menu}</span>
      <span class="nav__burger" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
  <span class="nav__progress" aria-hidden="true"><i data-progress-bar></i></span>
</header>

<div id="menu" class="menu on-dark" data-menu hidden>
  <nav aria-label={ui.nav.mobile}>
    <ol role="list" class="menu__list">
      {
        links.map((l, i) => (
          <li>
            <a href={l.href} data-menu-link>
              <span class="meta">{String(i + 1).padStart(2, '0')}</span>
              <span class="display">{l.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: max(0.9rem, env(safe-area-inset-top)) var(--gutter) 0.9rem;
    color: var(--tinta);
    transition: color var(--dur-slow) var(--ease-out);
    pointer-events: none;
  }

  .nav > * {
    pointer-events: auto;
  }

  /* Fondo de barra completa (móvil): transparente arriba, vidrio al hacer scroll.
     La capa de vidrio NO anima su opacidad (Chrome/Safari recortan el blur mientras
     una capa con backdrop-filter está semitransparente): se animan el tinte y el
     propio desenfoque, de 0 a 20 px. Se extiende por encima del viewport para que
     el rebote de iOS o la barra del navegador no dejen asomar una franja sin blur. */
  .nav::before {
    content: '';
    position: absolute;
    inset: -120px 0 0;
    z-index: -1;
    background-color: rgb(246 250 252 / 0);
    border-bottom: 1px solid rgb(255 255 255 / 0);
    box-shadow: 0 10px 30px -18px rgb(19 35 44 / 0);
    -webkit-backdrop-filter: blur(0px) saturate(100%);
    backdrop-filter: blur(0px) saturate(100%);
    transition:
      background-color var(--dur-slow) var(--ease-out),
      border-color var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-slow) var(--ease-out),
      -webkit-backdrop-filter var(--dur-slow) var(--ease-out),
      backdrop-filter var(--dur-slow) var(--ease-out);
    pointer-events: none;
  }

  /* en escritorio no hay barra completa: la capa no existe */
  @media (min-width: 900px) {
    .nav::before {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .nav {
      pointer-events: auto;
    }
    /* capa propia en el compositor: evita repintados y parpadeos del blur al hacer scroll */
    .nav {
      transform: translateZ(0);
    }
    .nav.is-scrolled::before {
      background-color: rgb(246 250 252 / 0.8);
      border-bottom-color: rgb(255 255 255 / 0.7);
      box-shadow: 0 10px 30px -18px rgb(19 35 44 / 0.35);
      -webkit-backdrop-filter: blur(20px) saturate(170%);
      backdrop-filter: blur(20px) saturate(170%);
    }
    :global(html[data-zone='dark']) .nav.is-scrolled::before {
      background-color: rgb(24 43 53 / 0.74);
      border-bottom-color: rgb(169 220 247 / 0.16);
      box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.6);
    }
    /* Botones en móvil: la barra es la única superficie de vidrio.
       "Menú" es una píldora sólida (mismo lenguaje que "Hablemos" en escritorio)
       y el cambio de idioma es texto limpio. */
    .nav .nav__lang,
    .nav .nav__toggle {
      border: 0;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .nav .nav__lang::before,
    .nav .nav__toggle::before {
      content: none;
    }
    .nav .nav__lang {
      --glass-fill: transparent;
      min-width: 40px;
      padding: 0 0.4rem;
      font-size: 0.78rem;
      letter-spacing: 0.14em;
      opacity: 0.78;
      transition: opacity var(--dur-base) var(--ease-out);
    }
    .nav .nav__lang:hover,
    .nav .nav__lang:focus-visible {
      opacity: 1;
    }
    .nav .nav__toggle {
      --glass-fill: var(--tinta);
      color: var(--crema);
      padding: 0 1.05rem;
      transition: background-color var(--dur-slow) var(--ease-out), color var(--dur-slow) var(--ease-out), transform var(--dur-base) var(--ease-out);
    }
    .nav .nav__toggle:active {
      transform: scale(0.96);
    }
    :global(html[data-zone='dark']) .nav .nav__lang {
      --glass-fill: transparent;
    }
    :global(html[data-zone='dark']) .nav .nav__toggle {
      --glass-fill: var(--celeste-500);
      color: var(--profundo-950);
    }
    /* con el menú abierto, la barra se funde con el panel oscuro */
    :global(html.menu-open) .nav {
      color: var(--crema);
    }
    :global(html.menu-open) .nav.is-scrolled::before {
      background-color: transparent;
      border-bottom-color: transparent;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .nav .nav__toggle[aria-expanded='true'] {
      --glass-fill: var(--celeste-500);
      color: var(--profundo-950);
    }
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav.is-scrolled::before { background-color: rgb(246 250 252 / 0.95); }
    :global(html[data-zone='dark']) .nav.is-scrolled::before { background-color: rgb(24 43 53 / 0.95); }
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav.is-scrolled::before {
      background-color: var(--niebla-50);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    :global(html[data-zone='dark']) .nav.is-scrolled::before { background-color: var(--profundo-900); }
  }

  :global(html[data-zone='dark']) .nav {
    color: var(--crema);
  }

  .nav__brand {
    justify-self: start;
    display: inline-flex;
    padding: 0.4rem 0.2rem;
    text-decoration: none;
  }

  .nav__brand :global(.nav__logo) {
    height: clamp(1.5rem, 1.2rem + 0.8vw, 2rem);
  }

  .nav__pill {
    border-radius: var(--radius-pill);
    padding: 0.3rem;
  }

  :global(html[data-zone='dark']) .nav__pill,
  :global(html[data-zone='dark']) .nav__toggle {
    --glass-fill: rgb(24 43 53 / 0.45);
    --glass-edge: rgb(169 220 247 / 0.22);
  }

  .nav__pill ul {
    display: flex;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__pill a {
    display: block;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-pill);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .nav__pill a[aria-current='true'] {
    background: rgb(110 193 240 / 0.28);
  }

  @media (hover: hover) {
    .nav__pill a:hover {
      background: rgb(110 193 240 / 0.18);
    }
  }

  .nav__end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav__lang {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    height: 44px;
    padding: 0 0.8rem;
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: background-color var(--dur-base) var(--ease-out);
  }

  :global(html[data-zone='dark']) .nav__lang {
    --glass-fill: rgb(24 43 53 / 0.45);
    --glass-edge: rgb(169 220 247 / 0.22);
  }

  @media (hover: hover) {
    .nav__lang:hover {
      --glass-fill: rgb(246 250 252 / 0.72);
    }
  }

  .nav__cta {
    min-height: 44px;
    padding-block: 0.6em;
  }

  :global(html[data-zone='dark']) .nav__cta {
    background: var(--celeste-500);
    color: var(--profundo-950);
  }

  .nav__toggle {
    display: none;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .nav__burger {
    display: grid;
    gap: 5px;
  }
  .nav__burger i {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .nav__toggle[aria-expanded='true'] .nav__burger i:first-child { transform: translateY(3.25px) rotate(45deg); }
  .nav__toggle[aria-expanded='true'] .nav__burger i:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  .nav__progress {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    overflow: hidden;
  }
  .nav__progress i {
    display: block;
    height: 100%;
    background: var(--celeste-500);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  @media (max-width: 899px) {
    .nav {
      grid-template-columns: 1fr auto;
    }
    .nav__pill,
    .nav__cta {
      display: none;
    }
    .nav__end {
      grid-column: 2;
    }
    .nav__toggle {
      display: inline-flex;
    }
  }

  /* Menú móvil a pantalla completa */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    display: grid;
    align-items: center;
    padding: 6rem var(--gutter) 3rem;
    background: rgb(14 26 33 / 0.86);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    backdrop-filter: blur(22px) saturate(150%);
  }
  .menu[hidden] {
    display: none;
  }
  .menu__list {
    display: grid;
    gap: 0.4rem;
  }
  .menu__list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.4rem 0;
    text-decoration: none;
  }
  .menu__list .display {
    font-size: clamp(2.4rem, 11vw, 4rem);
  }
</style>
