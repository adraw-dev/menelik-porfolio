---
// 01 · Eventos y celebraciones — álbum editorial asimétrico.
import Photo from '../ui/Photo.astro';
import CollectionHeader from './CollectionHeader.astro';
import type { Collection } from '../../data/photos';

interface Props { c: Collection }
const { c } = Astro.props;
const [a, b, d, e] = c.photos;
---

<section id={c.id} class="album" data-atmos={c.atmos} data-chapter={c.title} aria-labelledby={`${c.id}-title`}>
  <div class="wrap">
    <CollectionHeader c={c} />
    <div class="album__grid">
      <Photo class="album__a" photo={a} lightbox={c.id} caption={true} sizes="(min-width: 1024px) 56vw, 92vw" depth={0.12} />
      <Photo class="album__b" photo={b} lightbox={c.id} caption={true} sizes="(min-width: 1024px) 30vw, 60vw" depth={0.32} />
      <Photo class="album__c" photo={d} lightbox={c.id} caption={true} sizes="(min-width: 1024px) 28vw, 60vw" depth={0.22} />
      <Photo class="album__d" photo={e} lightbox={c.id} caption={true} sizes="(min-width: 1024px) 50vw, 92vw" depth={0.08} />
    </div>
  </div>
</section>

<style>
  .album {
    padding-block: clamp(3rem, 8vh, 6rem) var(--section-y);
  }

  .album__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gutter);
    row-gap: clamp(2rem, 6vw, 5rem);
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .album__grid :global(.photo__frame) {
    box-shadow: var(--shadow-print);
  }

  .album__grid :global(.album__a) { grid-column: 1 / span 7; grid-row: 1; align-self: start; }
  .album__grid :global(.album__b) { grid-column: 9 / span 4; grid-row: 1 / span 2; margin-top: 8rem; }
  .album__grid :global(.album__c) { grid-column: 2 / span 4; grid-row: 2 / span 2; }
  .album__grid :global(.album__d) { grid-column: 6 / span 6; grid-row: 3; align-self: end; margin-top: 6rem; }

  @media (max-width: 767px) {
    .album__grid :global(.album__a) { grid-column: 1 / -1; grid-row: auto; }
    .album__grid :global(.album__b) { grid-column: 4 / -1; grid-row: auto; margin-top: 0; }
    .album__grid :global(.album__c) { grid-column: 1 / span 9; grid-row: auto; }
    .album__grid :global(.album__d) { grid-column: 1 / -1; grid-row: auto; margin-top: 0; }
  }
</style>
